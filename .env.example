# Скопируйте в .env и подставьте свой ключ с https://apidata.mos.ru
MOS_API_KEY=
MOS_DATASET_ID=3247
# Допустимая нехватка строк относительно /count (0 - строгая сверка).
# Строк больше, чем /count, - всегда ошибка.
MOS_COUNT_TOLERANCE=0

# PostgreSQL: docker compose и загрузка clean -> Postgres
POSTGRES_HOST=
POSTGRES_PORT=
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=

# Airflow (docker compose): секреты - только здесь
AIRFLOW_UID=
AIRFLOW_DB_PASSWORD=
AIRFLOW_FERNET_KEY=
AIRFLOW_SECRET_KEY=
AIRFLOW_JWT_SECRET=
AIRFLOW_ADMIN_USER=
AIRFLOW_ADMIN_PASSWORD=
